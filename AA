      cursor: pointer;
      transition: 0.2s;
      box-shadow: 0 6px 14px rgba(15,44,59,0.12);
      text-decoration: none;
      display: inline-block;
    }

    .btn-primary:hover {
      background: #1c4256;
      transform: translateY(-2px);
    }

    .btn-outline {
      background: transparent;
